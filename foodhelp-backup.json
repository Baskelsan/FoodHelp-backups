          "quantity": 40,
          "unit": "g"
        },
        {
          "density_g_per_ml": 1.2,
          "name": "sel",
          "quantity": 1,
          "unit": "cc"
        },
        {
          "name": "poivre",
          "quantity": 1,
          "unit": "pincee"
        },
        {
          "name": "muscade",
          "note": "râpée",
          "optional": true,
          "quantity": 1,
          "unit": "pincee"
        }
      ],
      "notes": "Éviter le mixeur plongeant, qui rend les pommes de terre élastiques. Ajuster la quantité de lait selon la texture voulue. Avec du beurre demi-sel, réduire le sel.",
      "prep_minutes": 15,
      "servings": 4,
      "source": "Claude",
      "steps": [
        {
          "text": "Éplucher les pommes de terre et les carottes."
        },
        {
          "text": "Couper les pommes de terre en gros morceaux."
        },
        {
          "text": "Couper les carottes en rondelles."
        },
        {
          "text": "Mettre les légumes dans une casserole d'eau froide salée."
        },
        {
          "minutes": 25,
          "text": "Porter à ébullition et cuire jusqu'à ce que les carottes soient tendres."
        },
        {
          "text": "Égoutter les légumes."
        },
        {
          "minutes": 1,
          "text": "Remettre les légumes dans la casserole chaude pour évaporer l'eau."
        },
        {
          "text": "Écraser les légumes avec le beurre au presse-purée."
        },
        {
          "text": "Incorporer le lait chaud petit à petit."
        },
        {
          "text": "Assaisonner avec le poivre et la muscade, puis rectifier le sel."
        }
      ],
      "tags": [
