  "recipes": [
    {
      "cook_minutes": 25,
      "description": "Pâte à crêpes simple avec 2 œufs, pour environ 12 à 14 crêpes",
      "ingredients": [
        {
          "name": "farine",
          "quantity": 250,
          "unit": "g"
        },
        {
          "density_g_per_ml": 1.03,
          "name": "lait",
          "quantity": 500,
          "unit": "ml"
        },
        {
          "name": "œuf",
          "piece_weight_g": 55,
          "quantity": 2,
          "unit": "piece"
        },
        {
          "name": "beurre",
          "note": "fondu",
          "quantity": 40,
          "unit": "g"
        },
        {
          "density_g_per_ml": 1.2,
          "name": "sel",
          "quantity": 1,
          "unit": "pincee"
        },
        {
          "density_g_per_ml": 0.85,
          "name": "sucre",
          "optional": true,
          "quantity": 2,
          "unit": "cs"
        }
      ],
      "notes": "Si la pâte est trop épaisse après le repos, ajouter un peu de lait ou d'eau. Avec du beurre demi-sel, supprimer la pincée de sel.",
      "prep_minutes": 10,
      "servings": 6,
      "source": "Claude",
      "steps": [
        {
          "text": "Verser la farine, le sel et le sucre dans un saladier."
        },
        {
          "text": "Creuser un puits au centre."
        },
        {
          "text": "Casser les œufs dans le puits et mélanger au fouet en incorporant la farine petit à petit."
        },
        {
          "text": "Verser le lait progressivement en fouettant jusqu'à obtenir une pâte lisse."
        },
        {
          "text": "Ajouter le beurre fondu et mélanger."
        },
        {
          "minutes": 30,
          "text": "Couvrir et laisser reposer la pâte."
        },
        {
          "text": "Faire chauffer une poêle légèrement beurrée à feu moyen-vif."
        },
        {
          "text": "Verser une louche de pâte en inclinant la poêle pour la répartir."
        },
        {
          "minutes": 2,
          "text": "Cuire jusqu'à ce que les bords se détachent."
        },
        {
          "minutes": 1,
          "text": "Retourner la crêpe et cuire l'autre face."
        }
      ],
      "tags": [
        "crêpe",
        "sucré",
        "dessert",
        "goûter"
      ],
      "title": "Pâte à crêpes"
    },
    {
      "description": "Pâte brisée simple pour un moule à tarte, idéale pour les quiches",
      "ingredients": [
        {
          "name": "farine",
          "quantity": 250,
          "unit": "g"
        },
        {
          "name": "beurre demi-sel",
          "note": "froid, coupé en dés",
          "quantity": 125,
          "unit": "g"
        },
        {
          "density_g_per_ml": 1,
          "name": "eau",
          "note": "froide",
          "quantity": 50,
          "unit": "ml"
        }
      ],
      "notes": "Le beurre demi-sel apporte le sel : inutile d'en ajouter. La cuisson se fait avec la garniture.",
      "prep_minutes": 10,
      "servings": 6,
      "source": "Claude",
      "steps": [
        {
          "text": "Dans un saladier, sabler la farine et le beurre du bout des doigts jusqu'à obtenir une texture de sable grossier."
        },
        {
          "text": "Ajouter l'eau petit à petit et rassembler la pâte en boule sans trop la travailler."
        },
        {
          "minutes": 30,
          "text": "Filmer la pâte et la laisser reposer au frigo."
        },
        {
          "text": "Étaler la pâte et la déposer dans le moule à tarte."
        },
        {
          "text": "Piquer le fond de pâte avec une fourchette."
        }
      ],
      "tags": [
        "pâte",
        "pâte brisée",
        "salé",
        "quiche"
      ],
      "title": "Pâte brisée au beurre demi-sel"
    },
    {
      "cook_minutes": 25,
      "description": "Purée douce et onctueuse, mi-pomme de terre mi-carotte",
      "ingredients": [
        {
